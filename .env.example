# Coolify / production defaults. Coolify auto-generates SERVICE_PASSWORD_* values.
SITE_NAME=gatems.example.com
ADMIN_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me
DEVELOPER_MODE=0
# Leave empty so nginx uses $host (the public domain Coolify assigns)
FRAPPE_SITE_NAME_HEADER=

# Optional: set if Coolify does not inject SERVICE_URL_FRONTEND on first boot
# SERVICE_URL_FRONTEND=https://gatems.example.com
